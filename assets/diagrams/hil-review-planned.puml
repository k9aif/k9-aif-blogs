@startuml hil-review-planned
title K9-AIF 1.25.0: the same change waits for a person

actor "Fraudster" as F
participant "Router" as R
participant "Orchestrator" as O
participant "Squad" as S
participant "Email agent\n(unchanged code)" as A
participant "BaseConnector\ncall_tool()" as C
participant "BaseToolDispatcher" as D
participant "Rules engine\n(the solution's, e.g.\nK9X RulesEngine)" as RU
participant "BaseHILOrchestrator\n→ K9X HIL" as H
actor "Accounts payable\nreviewer" as V
participant "MCP server" as T
participant "Vendor service\n(system of record)" as VS

F -> R : email: "please use account X"
R -> O : route(vendor_email)
O -> S : execute
S -> A : execute(payload)
A -> C : call_tool("update_vendor_bank_details", V, X)
C -> D : intercepted: propose(ToolCall)
D -> D : k9x Shield: PASS\nToolRegistry: irreversible
D -> RU : execute({tool_call: facts})
RU --> D : no named rule allows it
D -> D : store the exact call (audit log)
D --> A : ToolCallPendingReview\n(nothing changed)
A --> S : propagates (if the agent's code\ncatches it, the base class raises it again)
S --> O : propagates
O -> H : handle_requires_hil()\n→ hil.requests.<queue>
H -> V : "change vendor V's bank account to X?"
V -> V : calls vendor V on the number\nalready on file
V --> H : decision
H --> R : hil.replies.<queue>
R -> O : resumed payload + decision
O -> D : resume_tool_call(decision)

alt approved, for this stored call, before the deadline
  D -> T : call_tool(stored arguments), once
  T -> VS : update vendor V
else rejected, expired or anything else
  D -> D : never executed, recorded
end
@enduml
