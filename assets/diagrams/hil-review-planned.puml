@startuml hil-review-planned
title Planned 1.25.0: every tool call passes one gate that checks values against records

participant "Agent" as A
participant "BaseToolDispatcher" as D
participant "k9x Shield" as SE
participant "ToolRegistry" as R
participant "k9x Origin" as OR
participant "BaseRulesAdapter\n(the solution's rules)" as RU
participant "HIL" as H
actor "Owner" as V
participant "MCP server\n(vetted tools)" as T

A -> D : propose release_payment(V, 4,800, X)
D -> SE : screen tool + arguments
SE --> D : PASS
D -> R : lookup("release_payment")
R --> D : irreversible\nverify: account = vendor.bank_account
D -> OR : get_current("vendor", V)
OR --> D : bank_account Y\n(from the system of record)
D -> D : X ≠ Y : mismatch
D -> RU : evaluate(irreversible, outside content,\nmismatch, requester role)
RU --> D : hil

D -> H : review: the request, the exact call,\n"account X is not V's account Y"
D --> A : pending (nothing executed)
H -> V : review
V --> D : decision, tied to this exact call

alt approved, for this exact call, before the deadline
  D -> T : call_tool(exact arguments)
else anything else
  D -> D : never executed, recorded
end
@enduml
