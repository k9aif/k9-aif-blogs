@startuml hil-review-classes
set separator none
title Planned 1.25.0 classes and the existing ABBs they use

package "New (planned 1.25.0)" {
  class BaseToolDispatcher {
    +propose(call: ToolCall)
    +resume(decision: ToolCallDecision)
  }
  class GatedToolClient {
    +call_tool(name, arguments)
  }
  class ToolRegistry {
    +lookup(tool_name): ToolSpec
  }
  class ToolSpec {
    name
    irreversible: bool
    verify: argument -> record field
  }
  class ToolCall {
    tool_name
    arguments
    request_id
    agent_id
    correlation_id
    rationale_untrusted
    +digest()
  }
  class ToolCallApprovalRequest {
    original_request
    call: ToolCall
    mismatches
  }
  class ToolCallDecision {
    approved: bool
    call_digest
    approver
    +parse(reply)
  }
  class ToolCallAuditLog {
    +record(event)
  }
}

package "Existing in K9-AIF" {
  abstract class BaseAgent
  class MCPClientConnectionFactory
  class ShieldGovernance {
    +post_process(payload)
  }
  abstract class BaseOrigin {
    +get_current(entity, id)
  }
  abstract class BaseRulesAdapter {
    +evaluate(ruleset, facts)
  }
  class K9RulesAdapter
  class RestRulesAdapter
  class BaseHILOrchestrator {
    +execute_flow(payload)
  }
  abstract class BaseConnector {
    +call_tool(name, arguments)
  }
}

BaseAgent --> GatedToolClient : the only tool client it gets
MCPClientConnectionFactory ..> GatedToolClient : returns
GatedToolClient --> BaseToolDispatcher : proposes
BaseToolDispatcher --> ToolCall
BaseToolDispatcher --> ShieldGovernance : screens
BaseToolDispatcher --> ToolRegistry
ToolRegistry --> ToolSpec
BaseToolDispatcher --> BaseOrigin : looks up records
BaseToolDispatcher --> BaseRulesAdapter : allow / hil / deny
BaseRulesAdapter <|-- K9RulesAdapter
BaseRulesAdapter <|-- RestRulesAdapter
BaseToolDispatcher --> ToolCallApprovalRequest : builds
BaseToolDispatcher --> BaseHILOrchestrator : publishes review
BaseToolDispatcher --> ToolCallDecision : checks digest
BaseToolDispatcher --> ToolCallAuditLog : records
BaseToolDispatcher --> BaseConnector : only caller of call_tool
@enduml
