@startuml tool-gate-at-a-glance
title Where the tool gate sits

left to right direction

rectangle "Deterministic flow\n(most business flows)" as DET {
  rectangle "Orchestrator\n\nour code decides\nwhat to call" as O
  rectangle "Integration adapter" as AD
}

rectangle "Model-driven flow\n(reading an email, choosing a tool)" as MOD {
  rectangle "Agent\n\na model decides\nwhat to call" as A
  rectangle "TOOL GATE\n(K9-AIF 1.25.0)\n\nthe agent can't skip it\nunknown action = irreversible\nirreversible = a person approves\napproval runs that exact call, once" as G
  rectangle "MCP tool" as M
}

rectangle "The system of record\n\nits own checks, as for decades:\nlook up, match, rules, limits" as SYS

O --> AD
AD --> SYS : no gate needed:\nno model to steer
A --> G
G --> M : allowed, or\napproved by a person
M --> SYS
@enduml
