@startuml hil-review-today
title Today: correct code and rules acting on a value the model extracted

actor "Requester" as U
participant "Orchestrator" as O
participant "Agent\n(BaseAgent)" as A
participant "k9x Shield\npre-check" as SI
participant "llm_invoke" as L
participant "K9RulesAgent\n(the solution's rules)" as RU
participant "MCP server\n(vetted tools)" as T
participant "k9x Shield\npost-check" as SE

U -> O : "process invoice INV-123"\n+ attached invoice
O -> A : execute(payload)
A -> SI : pre_process(prompt, invoice)
SI --> A : PASS\n(the instruction in the invoice\nmatches no pattern)
A -> L : llm_invoke("extract vendor, amount, account")
L --> A : vendor V, 4,800, account X
A -> RU : evaluate(invoice)
RU --> A : allow\n(amount under 5,000: no rule matched)
A -> T : call_tool("release_payment", V, 4,800, X)
T --> A : done
note right of T
  Account X came from the invoice.
  Nothing compared it with
  vendor V's account on record.
end note
A -> SE : post_process(output)
SE --> A : PASS\n(runs after the payment)
@enduml
